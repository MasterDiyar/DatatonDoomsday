PORT=4173
# Optional. Without a key, the transparent keyword-rule evaluator is used.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=180
# Approximate user-supplied USD prices per million tokens, not a price quote.
MODEL_INPUT_PRICE=0
MODEL_OUTPUT_PRICE=0
ORGANIZER_API_URL=
# Local development only: permits an OpenAI-compatible model on localhost.
# Set MODEL_API_KEY=local if your local server does not require authentication.
ALLOW_LOCAL_MODEL=0
